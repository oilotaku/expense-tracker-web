# staging 範本 — 部署主機上建 .env（或 .env.staging），禁沿用 development 值；secret 由部署者現場產生
APP_ENV=staging

POSTGRES_VERSION=18
REDIS_VERSION=8.10.1
PYTHON_VERSION=3.14
NODE_VERSION=24

# 對外 port（docker-compose.yml 的 ${...} 與 /start-dev 讀這裡）
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432

POSTGRES_DB=expense_tracker_web
POSTGRES_USER=expense_tracker_web
POSTGRES_PASSWORD=<generate-32-bytes-hex>
DATABASE_URL=postgresql+asyncpg://expense_tracker_web:<generate-32-bytes-hex>@db:5432/expense_tracker_web
JWT_SECRET_KEY=<generate-32-bytes-hex>
CORS_ORIGINS=["https://staging.example.com"]
