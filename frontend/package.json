{
  "name": "expense-tracker-web-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "24.x" },
  "scripts": {
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "comment:allowScripts": "npm ≥ 11 要求逐一核可依賴的 install script（CORE-145）。未列出的套件其 postinstall 不會執行，npm ci 會留下 warning。這裡是明確的核可紀錄，不是預設放行。",
  "allowScripts": {
    "unrs-resolver": true,
    "sharp": true,
    "msw": true
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@reduxjs/toolkit": "2.12.0",
    "react-redux": "9.3.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.26",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "vitest": "4.1.11",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1"
  }
}
