{
  "name": "expense-tracker-web-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "comment:allowScripts": "npm ≥ 11 要求逐一核可依賴的 install script（CORE-145）。未列出的套件其 postinstall 不會執行，npm ci 會留下 warning。這裡是明確的核可紀錄，不是預設放行。",
  "allowScripts": {
    "unrs-resolver": true,
    "sharp": true,
    "msw": true
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@reduxjs/toolkit": "2.12.0",
    "class-variance-authority": "0.7.1",
    "d3-shape": "3.2.0",
    "motion": "13.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-redux": "9.3.0",
    "recharts": "3.10.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
