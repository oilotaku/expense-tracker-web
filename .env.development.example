# development 範本 — scaffold 已產出實際 .env；若遺失，cp 本檔為 .env 並把 <generate-32-bytes-hex> 換成隨機值
APP_ENV=development

POSTGRES_VERSION=18
REDIS_VERSION=8.10.1
PYTHON_VERSION=3.14
NODE_VERSION=24

# 宿主機對外 port（docker-compose.yml 的 ${...} 與 /start-dev 讀這裡）
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

POSTGRES_DB=expense_tracker_web
POSTGRES_USER=expense_tracker_web
POSTGRES_PASSWORD=<generate-32-bytes-hex>
DATABASE_URL=postgresql+asyncpg://expense_tracker_web:<generate-32-bytes-hex>@db:5432/expense_tracker_web
# 報價快取（task-014，→ rules/40-cache）；backend 只在 compose 內跑，直接指向 redis service
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=<generate-32-bytes-hex>
# host 端 cron/systemd timer 呼叫 POST /internal/recurring/run 時用（→ CICD-086 排程慣例）
INTERNAL_TRIGGER_SECRET=<generate-32-bytes-hex>
CORS_ORIGINS=["http://localhost:3000"]
# browser 端呼叫後端 API 的網址；同區網其他裝置連線時改成本機的區網 IP（例：http://192.168.1.10:8000/api/v1）
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
